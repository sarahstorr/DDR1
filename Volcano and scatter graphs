clean_degs <- function(df, label) {
  df %>%
    filter(!is.na(padj), !is.na(external_gene_name), external_gene_name != "") %>%
    filter(padj < 0.05) %>%
    mutate(
      cell_line = label,
      direction = ifelse(log2FoldChange > 0, "Up", "Down"),
      abs_lfc   = abs(log2FoldChange)
    ) %>%
    group_by(external_gene_name) %>%
    slice_min(padj, n = 1, with_ties = FALSE) %>%
    ungroup()
}

