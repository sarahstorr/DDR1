make_volcano <- function(df_raw, label, top_n = 20) {
  
  plot_df <- df_raw %>%
    filter(!is.na(padj), !is.na(external_gene_name), external_gene_name != "") %>%
    mutate(
      sig = case_when(
        padj < 0.05 & log2FoldChange >  1 ~ "Up",
        padj < 0.05 & log2FoldChange < -1 ~ "Down",
        TRUE                               ~ "ns"
      ),
      neg_log10_padj = pmin(-log10(padj), 300)
    )
  
  top_up   <- plot_df %>%
    filter(sig == "Up")   %>% slice_max(abs(log2FoldChange), n = top_n / 2)
  top_down <- plot_df %>%
    filter(sig == "Down") %>% slice_max(abs(log2FoldChange), n = top_n / 2)
  label_df <- bind_rows(top_up, top_down)
  
  n_up   <- sum(plot_df$sig == "Up",   na.rm = TRUE)
  n_down <- sum(plot_df$sig == "Down", na.rm = TRUE)
  
  p <- ggplot(plot_df,
              aes(x = log2FoldChange, y = neg_log10_padj, colour = sig)) +
    geom_point(alpha = 0.5, size = 1.8) +
    geom_hline(yintercept = -log10(0.05), linetype = "dashed",
               colour = "grey50", linewidth = 0.6) +
    geom_vline(xintercept = c(-1, 1), linetype = "dashed",
               colour = "grey50", linewidth = 0.6) +
    geom_text_repel(
      data           = label_df,
      aes(label      = external_gene_name),
      size           = GENE_SIZE,
      fontface       = "bold.italic",
      max.overlaps   = 30,
      box.padding    = 0.4,
      segment.colour = "grey55",
      show.legend    = FALSE
    ) +
    scale_colour_manual(
      values = c("Up" = "#E74C3C", "Down" = "#2980B9", "ns" = "grey75"),
      labels = c(
        "Up"   = paste0("Up (n=", n_up, ")"),
        "Down" = paste0("Down (n=", n_down, ")"),
        "ns"   = "n.s."
      ),
      name = NULL
    ) +
    labs(
      title    = paste0("DDR1 Knockdown — ", label),
      subtitle = expression("Highlighted: padj < 0.05 and |"*log[2]*"FC| > 1"),
      x        = expression(bold(log[2])~bold("Fold Change (knockdown vs control)")),
      y        = expression(bold(-log[10])~bold("(adjusted p-value)"))
    ) +
    pub_theme +
    theme(legend.position = "top",
          legend.text     = element_text(size = BASE))
  
  print(p)
}

make_volcano(t47d_raw,  "T47D (ER+ Breast)")
make_volcano(igrov_raw, "IGROV1 (Ovarian)")

# =============================================================================
# FIGURES 4-7 — KEGG enrichment dotplots
# =============================================================================

run_kegg <- function(gene_symbols, label) {
  
  if (length(gene_symbols) < 10) {
    cat("  SKIP KEGG for", label, "— too few genes\n")
    return(invisible(NULL))
  }
  
  entrez <- bitr(gene_symbols,
                 fromType = "SYMBOL",
                 toType   = "ENTREZID",
                 OrgDb    = org.Hs.eg.db,
                 drop     = TRUE)
  
  cat("  KEGG", label, ": mapped", nrow(entrez), "of",
      length(gene_symbols), "genes to Entrez\n")
  
  if (nrow(entrez) < 10) return(invisible(NULL))
  
  ekegg <- enrichKEGG(
    gene          = entrez$ENTREZID,
    organism      = "hsa",
    pAdjustMethod = "BH",
    pvalueCutoff  = 0.05
  )
  
  if (is.null(ekegg) || nrow(ekegg@result) == 0) {
    cat("  No significant KEGG pathways for", label, "\n")
    return(invisible(NULL))
  }
  
  n_paths <- nrow(ekegg@result[ekegg@result$p.adjust < 0.05, ])
  cat("  Significant KEGG pathways for", label, ":", n_paths, "\n")
  
  p <- dotplot(ekegg, showCategory = 20, font.size = AX_TEXT - 2) +
    labs(
      title    = paste0("KEGG Pathways — ", label),
      subtitle = paste0(n_paths, " significant pathways (padj < 0.05)")
    ) +
    theme_bw(base_size = BASE) +
    theme(
      plot.title    = element_text(size = BASE + 1, face = "bold"),
      plot.subtitle = element_text(size = BASE - 2, colour = "grey45"),
      axis.title.x  = element_text(size = AX_TITLE, face = "bold"),
      axis.text.x   = element_text(size = AX_TEXT),
      axis.text.y   = element_text(size = AX_TEXT),   # pathway name size
      legend.text   = element_text(size = BASE - 2),
      legend.title  = element_text(size = BASE - 1),
      panel.grid.minor = element_blank()
    )
  
  print(p)
  invisible(ekegg)
}

